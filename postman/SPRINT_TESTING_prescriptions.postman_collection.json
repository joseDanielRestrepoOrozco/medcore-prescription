			"item": [
				{
					"name": "Login como MEDICO",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('authToken', response.token);",
									"    pm.collectionVariables.set('doctorId', response.user.id);",
									"    console.log('✅ Token guardado para MEDICO');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"doctor@medcore.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{authServiceUrl}}/auth/login",
							"host": [
								"{{authServiceUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Obtiene token JWT para un médico"
					},
					"response": []
				},
