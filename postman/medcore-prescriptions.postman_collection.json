				{
					"name": "Crear Prescripción SIN alergias",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.environment.set(\"prescription_id\", jsonData.prescription.id);",
									"    console.log(\"Prescripción creada:\", jsonData.prescription.prescriptionNumber);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{doctor_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": \"{{patient_id}}\",\n  \"diagnosis\": \"Infección respiratoria aguda\",\n  \"observations\": \"Paciente con tos y fiebre. Tomar abundante líquido.\",\n  \"medications\": [\n    {\n      \"name\": \"Amoxicilina\",\n      \"genericName\": \"Amoxicilina\",\n      \"dosage\": \"500mg\",\n      \"frequency\": \"Cada 8 horas\",\n      \"duration\": 7,\n      \"durationType\": \"días\",\n      \"administrationRoute\": \"Oral\",\n      \"instructions\": \"Tomar después de las comidas\"\n    },\n    {\n      \"name\": \"Acetaminofén\",\n      \"genericName\": \"Paracetamol\",\n      \"dosage\": \"500mg\",\n      \"frequency\": \"Cada 6 horas\",\n      \"duration\": 5,\n      \"durationType\": \"días\",\n      \"administrationRoute\": \"Oral\",\n      \"instructions\": \"Solo si hay fiebre mayor a 38°C\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/prescriptions",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "prescriptions"]
						},
